{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "react", "jsx-a11y", "vitest"],
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "18.3.1"
    }
  },
  "options": {
    "typeAware": true,
    "typeCheck": false,
    "maxWarnings": 0
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "vitest/expect-expect": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "eslint",
            "message": "ESLint is not part of the approved TypeScript 7 toolchain."
          }
        ],
        "patterns": ["@typescript-eslint/*"]
      }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/test/**/*.{test,spec}.{ts,tsx}"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", "src/devtools/toolboxMenu.tsx"]
}
