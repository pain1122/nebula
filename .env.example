APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local/testing fixtures only. DatabaseSeeder blocks these in production.
SEED_DEMO_DATA=true
DEMO_SANDBOX_PAYMENTS=true
DEMO_SEED_PASSWORD=Password123!

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=checkupino
DB_USERNAME=checkupino
DB_PASSWORD=checkupino_pass

# Used only by an isolated tenant deployment or tenant-foundation verification.
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=db
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=checkupino_tenant
TENANT_DB_USERNAME=checkupino
TENANT_DB_PASSWORD=checkupino_pass

# Local-only Ed25519 entitlement fixture. Tenants keep public keys only;
# marketplace signing deployments keep the private seed in secret storage.
TENANT_ENTITLEMENT_PUBLIC_KEYS='{"local-v1":"QkiCWzBBByY2OKF9IamIeV2amVA1clUriYie3malnmc="}'
TENANT_ENTITLEMENT_SIGNING_KEY_ID=local-v1
TENANT_ENTITLEMENT_SIGNING_SEED=xSyXxr0zD6TpVRn4tqCwPossPoQj649ktn4jd9Szikg=
TENANT_ENTITLEMENT_CLOCK_SKEW_SECONDS=300

# Marketplace-only map of secret references to base64 machine secrets.
TENANT_MONITORING_MACHINE_SECRETS='{}'
TENANT_MONITORING_MAX_AGE_SECONDS=300

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,127.0.0.1,127.0.0.1:3000,127.0.0.1:8080
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
AUTH_HIGH_AUTHORITY_PASSWORD_TIMEOUT=900
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=30
OUTBOX_PROCESSING_LEASE_SECONDS=300
PAYMENT_HOLD_MINUTES=60
PAYMENT_MAX_ACTIVE_HOLDS_PER_USER=3
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_USER=10
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_DEVICE=10
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_IP=30
QUESTIONNAIRE_SUBMISSIONS_PER_USER_PER_MINUTE=10
QUESTIONNAIRE_SUBMISSIONS_PER_PHONE_PER_MINUTE=5
QUESTIONNAIRE_SUBMISSIONS_PER_IP_PER_MINUTE=30

MEDICAL_RECORDS_RETENTION_DAYS=365
MEDICAL_SCAN_ENABLED=false
MEDICAL_SCAN_SOCKET=/run/medical-scan/clamd.sock

# Whole-file bytes, separate from PHP/Nginx multipart body settings.
# Raising capacity requires accepted transport/storage/scanner capacity first.
UPLOAD_CAPACITY_MAX_BYTES=10485760
MEDICAL_UPLOAD_MAX_BYTES=10485760
PUBLIC_MEDIA_UPLOAD_MAX_BYTES=5242880
MEDICAL_SCAN_MAX_BYTES=10485760

# Medical storage admission; independent of per-file and issued attachment limits.
# Archived/expired metadata still consumes allowance until audited disposal exists.
MEDICAL_UPLOAD_ACCOUNT_MAX_FILES=100
MEDICAL_UPLOAD_ACCOUNT_MAX_BYTES=104857600
MEDICAL_UPLOAD_REQUEST_MAX_FILES=10
MEDICAL_UPLOAD_REQUEST_MAX_BYTES=26214400
MEDICAL_UPLOAD_REQUESTS_PER_USER_PER_MINUTE=10
MEDICAL_UPLOAD_REQUESTS_PER_IP_PER_MINUTE=30
MEDICAL_UPLOAD_CONCURRENT_UPLOADS=4
MEDICAL_UPLOAD_LEASE_SECONDS=120
MEDICAL_UPLOAD_GUARD_CACHE_STORE=database

# local until the SeaweedFS evaluation is deployed; medical-s3 also supports AWS.
MEDICAL_STORAGE_DRIVER=local
MEDICAL_S3_ACCESS_KEY_ID=
MEDICAL_S3_SECRET_ACCESS_KEY=
MEDICAL_S3_REGION=us-east-1
MEDICAL_S3_BUCKET=
MEDICAL_S3_ENDPOINT=
MEDICAL_S3_USE_PATH_STYLE_ENDPOINT=true
# Synthetic local evaluation only; production requires HTTPS.
MEDICAL_S3_ALLOW_INSECURE_HTTP=false

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Editorial image library: activate only after exact schema and real scanner/parser acceptance.
# Fresh independent local demo only; keep false until real scanner/parser readiness.
# Second seed stage uploads synthetic bytes and delivers only its exact encrypted jobs.
DEMO_SEED_VERIFIED_MEDIA=false
ARTICLE_MEDIA_ENABLED=false
ARTICLE_PRESENTATION_ENABLED=false
ARTICLE_SCHEDULING_ENABLED=false
ARTICLE_PUBLISHER_ENABLED=false
ARTICLE_MEDIA_STORAGE_DRIVER=local
# For S3/SeaweedFS use a separate private editorial bucket and dedicated credentials.
ARTICLE_MEDIA_S3_ACCESS_KEY_ID=
ARTICLE_MEDIA_S3_SECRET_ACCESS_KEY=
ARTICLE_MEDIA_S3_REGION=us-east-1
ARTICLE_MEDIA_S3_BUCKET=
ARTICLE_MEDIA_S3_ENDPOINT=
ARTICLE_MEDIA_S3_USE_PATH_STYLE_ENDPOINT=true
ARTICLE_MEDIA_S3_ALLOW_INSECURE_HTTP=false
