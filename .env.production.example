APP_NAME=Checkupino
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
# Replace the example domains with the deployed HTTPS API and admin origins.
APP_URL=https://api.example.com

# Demo identities and known credentials must remain disabled in production.
SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=checkupino
DB_USERNAME=checkupino
DB_PASSWORD=change_me

# Configure only for a separately deployed tenant database context.
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=db
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=replace_with_tenant_database
TENANT_DB_USERNAME=replace_with_tenant_user
TENANT_DB_PASSWORD=change_me

# JSON key ring distributed by the marketplace. Tenant deployments leave the
# signing key ID/seed empty; only the marketplace issuer receives a private seed.
TENANT_ENTITLEMENT_PUBLIC_KEYS='{"replace-key-id":"replace_with_base64_ed25519_public_key"}'
TENANT_ENTITLEMENT_SIGNING_KEY_ID=
TENANT_ENTITLEMENT_SIGNING_SEED=
TENANT_ENTITLEMENT_CLOCK_SKEW_SECONDS=300

# Marketplace-only secret-reference map. Do not copy tenant secrets into a
# tenant database or source control.
TENANT_MONITORING_MACHINE_SECRETS='{}'
TENANT_MONITORING_MAX_AGE_SECONDS=300

MYSQL_DATABASE=checkupino
MYSQL_USER=checkupino
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=admin.example.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
AUTH_HIGH_AUTHORITY_PASSWORD_TIMEOUT=900
CORS_ALLOWED_ORIGINS=https://admin.example.com

CACHE_STORE=redis
QUEUE_CONNECTION=database
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=30
OUTBOX_PROCESSING_LEASE_SECONDS=300
PAYMENT_HOLD_MINUTES=60
PAYMENT_MAX_ACTIVE_HOLDS_PER_USER=3
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_USER=10
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_DEVICE=10
PAYMENT_HOLD_REQUESTS_PER_MINUTE_PER_IP=30
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HTTP_PORT=8080
RUN_MIGRATIONS=false
CACHE_LARAVEL=false
